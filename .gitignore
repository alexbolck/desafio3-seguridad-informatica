# Dependencias
**/vendor/
**/node_modules/

# Variables de entorno (nunca subir credenciales reales)
**/.env
!**/.env.example

# Laravel
**/storage/*.key
**/bootstrap/cache/*.php
**/storage/logs/*.log
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*

# Certificados privados (no subir la llave privada)
certs/*.key

# Sistema
.DS_Store
Thumbs.db